# Copy to ".env" and fill in. NEVER commit .env.

# ---------- Required ----------
# Claude API key: platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# GoDaddy Personal Access Token: developer.godaddy.com (scope: domains.domain:read)
GODADDY_PAT=gd_pat_REPLACE_ME
GODADDY_BASE_URL=https://api.godaddy.com
USD_INR=85

# ---------- Environment ----------
# development (local) | production (VPS). Production refuses to start with unsafe settings
# (default SECRET_KEY, no DOMAIN, no SMTP) and never shows login codes on screen.
ENV=development

# ---------- Login / security ----------
# Long random string. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
# Locally, when SMTP isn't set up, login codes are shown in the terminal and on the login screen.
# This is ALWAYS off when ENV=production.
DEV_LOGIN_CODES=true

# ---------- Photos (optional but recommended) ----------
# Openverse works without a key. A free Pexels key gives better photos: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------- Email for website enquiry forms (Titan mailbox) ----------
# GoDaddy-created mailboxes usually need smtpout.secureserver.net (not smtp.titan.email). Username = full email.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Inbox that receives enquiries when a business owner gave no email
MAIL_TO=

# ---------- Production only (VPS) ----------
# Your domain. Caddy serves the app on it (HTTPS automatic) and every business site on https://<slug>.<DOMAIN>
# With ENV=production, PUBLIC_API_URL defaults to https://<DOMAIN> and SITE_URL_TEMPLATE to https://{slug}.<DOMAIN>/
DOMAIN=
# PUBLIC_API_URL=https://saheliai.com
# SITE_URL_TEMPLATE=https://{slug}.saheliai.com/

# Build the 5 demo websites + download landing photos in the background on first start (needs internet). 0 = off
AUTO_WARMUP=1

# ---------- Reliability ----------
# Emails allowed to run failure drills (Claude down / GoDaddy down / timeouts) from the chat's "log" panel
ADMIN_EMAILS=
# Max seconds per Claude call, and per agent turn (all Claude + tool calls together)
CLAUDE_TIMEOUT=90
AGENT_TURN_BUDGET=100
LOG_LEVEL=INFO
# Worker threads for blocking calls (Claude can take ~100 s per turn)
WORKER_THREADS=100
