# DOMAIN comes from .env (e.g. saheliai.com). Locally (DOMAIN unset) everything is served on :80.
{
	on_demand_tls {
		# only issue certificates for subdomains that belong to a generated website
		ask http://api:8000/internal/tls-allow
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$DOMAIN::80}, www.{$DOMAIN:localhost} {
	import security_headers
	encode zstd gzip
	header {
		# the app itself may only be framed by itself; mic + camera are used for voice and product photos
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
	}
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}
	handle /mcp/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@images path /women/* /favicon* *.webp *.png *.jpg *.svg
		header @images Cache-Control "public, max-age=2592000"
		try_files {path} /index.html
		file_server
	}
}

# Every business website: https://<slug>.<DOMAIN>  ->  /data/sites/<slug>/
https:// {
	tls {
		on_demand
	}
	import security_headers
	encode zstd gzip
	# private data lives next to the site files: never serve it (owner profile, customer enquiries)
	@private path /site.json *.jsonl /*.db
	respond @private 404
	header {
		# sites may be previewed inside the Saheli app (dashboard + showcase), nowhere else
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN:localhost} https://www.{$DOMAIN:localhost}"
		Permissions-Policy "microphone=(), camera=(), geolocation=()"
	}
	header /img/* Cache-Control "public, max-age=2592000"
	root * /data/sites/{labels.2}
	file_server
}
